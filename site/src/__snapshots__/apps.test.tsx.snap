        <button
          aria-pressed="false"
        >
          Packed (0)
        </button>
        <button
          aria-pressed="true"
        >
          All (3)
        </button>
      </p>
      <table
        class="pack-table"
      >
        <thead>
          <tr>
            <th>
              Order #
            </th>
            <th>
              Pack by
            </th>
            <th>
              Items
            </th>
            <th>
              Delivery
            </th>
            <th>
              Status
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <button>
                #1041
              </button>
            </td>
            <td>
              Today
            </td>
            <td>
              2
            </td>
            <td>
              Express
            </td>
            <td>
              <span
                class="badge"
              >
                To pack
              </span>
            </td>
          </tr>
          <tr>
            <td>
              <button>
                #1042
              </button>
            </td>
            <td>
              Today
            </td>
            <td>
              2
            </td>
            <td>
              Standard
            </td>
            <td>
              <span
                class="badge"
              >
                To pack
              </span>
            </td>
          </tr>
          <tr>
            <td>
              <button>
                #1043
              </button>
            </td>
            <td>
              Tomorrow
            </td>
            <td>
              1
            </td>
            <td>
              Standard
            </td>
            <td>
              <span
                class="badge"
              >
                To pack
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
