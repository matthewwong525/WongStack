exports[`offers three examples, one pressed at a time, each a sample Claymoo screen in its own browser window > Pack Station 1`] = `
<section
  class="band band-shade apps"
>
  <h2>
    Tools you can build
  </h2>
  <p
    class="lede"
  >
    Build around your own workflow. Try these examples.
  </p>
  <p
    class="chips"
  >
    <button
      aria-pressed="true"
    >
      Pack Station
    </button>
    <button
      aria-pressed="false"
    >
      Profit by channel
    </button>
    <button
      aria-pressed="false"
    >
      Ad briefs
    </button>
  </p>
  <p
    class="lede"
  >
    <b>
      Pack Station
      .
    </b>
     
    Scan each item before marking an order packed.
  </p>
  <section
    aria-label="Pack Station app, sample data"
    class="browser"
  >
    <p
      class="browser-bar"
    >
      <i />
      <i />
      <i />
      <span>
        your-app.your-name.workers.dev/
        pack-station
      </span>
    </p>
    <div
      class="admin"
    >
      <p
        class="admin-head"
      >
        <span
          aria-hidden="true"
          class="admin-mark"
        >
          C
        </span>
        <b>
          Claymoo Admin
        </b>
        <span>
          Docs
        </span>
        <span>
          Sign out
        </span>
      </p>
      <h3>
        Pack Station
      </h3>
      <p
        class="admin-tabs"
      >
        <b>
          Pack
        </b>
        <span>
          Flagged Orders
        </span>
      </p>
      <p
        class="admin-toolbar"
      >
        <input
          aria-label="Scan packing slip"
          placeholder="Scan packing slip…"
          readonly=""
        />
        <button
          class="button"
        >
          Start Packing
        </button>
      </p>
      <p
        class="chips"
      >
        <button
          aria-pressed="false"
