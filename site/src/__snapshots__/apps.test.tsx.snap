exports[`opens the static brief, adds a marker, and approves it into the publish queue > static brief 1`] = `
<section
  aria-label="Ad briefs app, sample data"
  class="browser"
>
  <p
    class="browser-bar"
  >
    <i />
    <i />
    <i />
    <span>
      your-app.your-name.workers.dev/
      briefs
    </span>
  </p>
  <div
    class="admin"
  >
    <p
      class="admin-head"
    >
      <span
        aria-hidden="true"
        class="admin-mark"
      >
        C
      </span>
      <b>
        Claymoo Admin
      </b>
      <span>
        Docs
      </span>
      <span>
        Sign out
      </span>
    </p>
    <h3>
      Static ad brief
    </h3>
    <button
      class="admin-back"
    >
      ← 
      Briefs
    </button>
    <p
      class="admin-title"
    >
      <b>
        Spring kit · static
      </b>
       
      <span
        class="badge"
      >
        Static
      </span>
       
      <span
        class="badge"
      >
        Draft
      </span>
    </p>
    <p
      class="note"
    >
      2 designs · revision 1
    </p>
    <div
      class="card"
    >
      <h4>
        Notes
      </h4>
      <textarea
        aria-label="Notes"
      >
        Warm light. Show hands, not faces.
      </textarea>
    </div>
    <div
      class="card"
    >
      <h4>
        Variations
      </h4>
      <div
        class="brief-variations"
      >
        <p
          aria-label="Reference picture with 3 numbered markers"
          class="brief-picture"
          role="img"
        >
          <b>
            1
          </b>
          <b>
            2
          </b>
          <b>
            3
          </b>
        </p>
        <table>
          <thead>
            <tr>
              <th>
                Marker
              </th>
              <th>
                Variation A
              </th>
              <th>
                Variation B
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <b>
                  1
                </b>
                 
                Headline
              </td>
              <td>
                Your first clay figure tonight
              </td>
              <td>
                Make a frog in 20 minutes
              </td>
            </tr>
            <tr>
              <td>
                <b>
                  2
                </b>
                 
                Primary text
              </td>
              <td>
                Everything in one box.
              </td>
              <td>
                No kiln. No mess.
              </td>
            </tr>
            <tr>
              <td>
                <b>
                  3
                </b>
                 
              </td>
              <td>
                —
              </td>
              <td>
                —
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <button
        class="admin-back"
      >
        + Add marker
      </button>
    </div>
    <p
      class="brief-bar"
    >
      <button
        class="button"
      >
        Approve
      </button>
    </p>
  </div>
</section>
`;

exports[`packs an order: scan every item, then Complete, and the list shows it packed > all scanned 1`] = `
<div
  class="pack-items"
>
  <button
    aria-label="Scan Cow clay kit: 1 of 1"
    class="pack-item pack-done"
    disabled=""
  >
    <i
      aria-hidden="true"
    />
    <span>
      <b>
        Cow clay kit
      </b>
       SKU: 
      CK-COW
    </span>
    <strong>
      1/1
       ✓
    </strong>
  </button>
  <button
    aria-label="Scan Sculpting tools: 1 of 1"
    class="pack-item pack-done"
    disabled=""
  >
    <i
      aria-hidden="true"
    />
    <span>
      <b>
        Sculpting tools
      </b>
       SKU: 
      TL-SCULPT
    </span>
    <strong>
      1/1
       ✓
    </strong>
  </button>
</div>
`;

