// The live line's own Worker, for the live app only: no web address, and the app points at it. Deploys use the
// default branch's copy of this file; a branch picks only the line's code. wiki/stack/live-line.md
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wongstack-line",
	"main": "worker/line-worker.ts",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": ["nodejs_compat", "disallow_importable_env"],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{ "binding": "DB", "database_name": "wongstack-db", "database_id": "322d78e8-19e1-4bf0-8489-faa13c66deb1" }
	],
	"durable_objects": { "bindings": [{ "name": "LINE", "class_name": "Line" }] },
	"migrations": [{ "tag": "line-1", "new_sqlite_classes": ["Line"] }],
	"env": {
		"local": {
			"name": "wongstack-line-local",
			"d1_databases": [
				{ "binding": "DB", "database_name": "wongstack-db-local", "database_id": "322d78e8-19e1-4bf0-8489-faa13c66deb1", "remote": false }
			],
			"durable_objects": { "bindings": [{ "name": "LINE", "class_name": "Line" }] }
		}
	}
}
