{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "worker/index.ts",
    // This Access module ships inert until a target adopts the login wall.
    "worker/access.ts",
    "review/*.test.mjs"
  ],
  "project": ["worker/**/*.ts", "src/**/*.{ts,tsx}", "review/**/*.mjs"],
  "vite": {
    "config": ["vite.config.ts"]
  },
  "vitest": {
    "config": ["vitest.config.ts"]
  }
}
