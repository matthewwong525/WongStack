{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "complexity": ["error", 21],
    "max-lines": ["error", 500],
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      // A ready-made part exports its style variants beside the component, as its makers wrote it.
      // Every other rule still holds in this folder.
      "files": ["src/components/ui/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      // A mini app's page keeps to its own folder, the shared parts and the shared helpers.
      "files": ["src/apps/*/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["../**", "!../../lib/**", "!../../components/**", "@/apps/**", "@/pages/**"],
          "message": "A mini app imports only its own folder, src/lib/ and src/components/."
        }] }]
      }
    },
    {
      // Its server side keeps to its own folder and the shared action contract.
      "files": ["worker/apps/*/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["../**", "!../../api/contract.ts", "!../../api/body.ts"],
          "message": "A mini app's server side imports only its own folder and worker/api/contract.ts."
        }] }]
      }
    },
    {
      // A test opens its app inside the main app's router and Home, so the folder rule skips test files.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
