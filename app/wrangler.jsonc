/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wongstack",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-28",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Production's bindings. `migrations_dir` is relative to THIS file, not the
	// repo root — `schema/` stays at the root, so from `app/` it's `../`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wongstack-db",
			"database_id": "322d78e8-19e1-4bf0-8489-faa13c66deb1",
			"migrations_dir": "../schema/migrations"
		},
		// Session memory, production only: staging and previews bind no memory
		// store. The memory skill migrates it, never CI. wiki/development/memory.md
		{
			"binding": "MEMORY_DB",
			"database_name": "wongstack-memory",
			"database_id": "dd7fc25d-9325-4ad5-945e-f4a336549c52"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEMORY_BUCKET",
			"bucket_name": "wongstack-memory"
		}
	],
	// Staging is a whole second Worker, not a binding swap. It needs its own
	// `name` (without one, a branch deploy lands on production) and its own
	// twin of every stateful binding — an environment inherits nothing it
	// doesn't redeclare. See wiki/stack/d1-pipeline.md.
	"env": {
		"staging": {
			"name": "wongstack-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wongstack-db-staging",
					"database_id": "0e5a5be6-1eca-4b99-ab10-5decaa4c55f5",
					"migrations_dir": "../schema/migrations"
				}
			]
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}