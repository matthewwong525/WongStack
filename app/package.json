{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite",
    "build": "bash ../scripts/cf-build.sh",
    "build:app": "tsc -b && vite build",
    "db:reset:staging": "node ../scripts/reset-staging-d1.mjs",
    "secrets:push": "node ../scripts/cf-secrets.mjs push",
    "secrets:check": "node ../scripts/cf-secrets.mjs check",
    "lint": "oxlint --deny-warnings",
    "test": "npm run lint && vitest run --coverage && knip && jscpd",
    "preview": "npm run build && vite preview",
    "deploy": "bash ../scripts/cf-deploy.sh",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jscpd": "^5.3.3",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.86.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
