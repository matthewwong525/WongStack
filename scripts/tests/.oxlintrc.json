{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["../lint-comment-length.mjs"],
  "rules": {
    "comment-length/max-comment-lines": ["error", 2],
    "comment-length/max-comment-width": ["error", 120]
  },
  "overrides": [
    {
      // Its bytes are pinned by app/worker/employee-access/bootstrap-release.json; a comment edit breaks the pin.
      "files": ["**/employee-bootstrap.mjs"],
      "rules": { "comment-length/max-comment-lines": "off", "comment-length/max-comment-width": "off" }
    }
  ]
}
