{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [{ "type": "command", "command": "PATH=\"$HOME/.local/bin:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\" --agent claude", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "PATH=\"$HOME/.local/bin:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/daily.mjs\" mark --agent claude", "timeout": 3 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "PATH=\"$HOME/.local/bin:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/daily.mjs\" mark --agent claude", "timeout": 3 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "PATH=\"$HOME/.local/bin:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/daily.mjs\" mark --agent claude", "timeout": 3 },
        { "type": "command", "command": "PATH=\"$HOME/.local/bin:$PATH\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-check.mjs\" stop --agent claude", "timeout": 300 }
      ] }
    ]
  }
}
