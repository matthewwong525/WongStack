{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/skills/daily/scripts/session-start.mjs\" --agent codex", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/skills/daily/scripts/daily.mjs\" mark --agent codex", "timeout": 3 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/skills/daily/scripts/daily.mjs\" mark --agent codex", "timeout": 3 },
        { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/skills/daily/scripts/stop-check.mjs\" stop --agent codex", "timeout": 300 }
      ] }
    ]
  }
}
