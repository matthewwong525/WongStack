{
  "manifest_version": 2,
  "name": "WongStack",
  "version": "1.0.0",
  "description": "Hand back: ends every turn that waits on you, and wakes each chat.",
  "browser_specific_settings": { "gecko": { "id": "hand-back@wongstack" } },
  "permissions": ["http://127.0.0.1/*"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Hand back", "default_icon": "bell.svg" },
  "icons": { "48": "bell.svg" }
}
